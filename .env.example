# Supabase (server-side)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase (browser-side - SvelteKit public variables)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OpenAI (for embeddings, text-embedding-3-small)
OPENAI_API_KEY=sk-your-openai-key

# DeepSeek (for text generation, deepseek-flash, via the Vercel AI SDK)
DEEPSEEK_API_KEY=
AI_MODEL=deepseek-flash

# Langfuse Cloud (server-only; optional for ordinary tests and local app execution)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_TRACING_ENABLED=false
# LANGFUSE_RELEASE=<application commit or release>
AI_BASE_URL=https://api.deepseek.com
# Retained compatibility knob; both routes currently use DeepSeek V4.1 Flash.
DEEPSEEK_FLASH_CANARY_PERCENT=0

# Eval-only prose judge; defaults to AI_MODEL. Human calibration is still required.
AI_EVAL_JUDGE_MODEL=

# Admin API Key (for /api/events endpoint - optional for local dev)
ADMIN_API_KEY=your-secret-api-key

# Browserbase (cloud browser for Passline/Meetup scraping in prod - bypasses datacenter-IP blocks)
BROWSERBASE_API_KEY=bb_live_your-key

# Trigger.dev (background jobs; SDK reads TRIGGER_SECRET_KEY)
# Dev key (tr_dev_...) from the dashboard for local `trigger dev` runs.
# Prod key (tr_prod_...) from dashboard → env/prod → API keys; use with
# configure({ secretKey: process.env.TRIGGER_SECRET_KEY_PROD }) to view/trigger prod runs.
TRIGGER_SECRET_KEY=tr_dev_your-key
TRIGGER_SECRET_KEY_PROD=tr_prod_your-key

# Telegram anonymous private-chat pilot
# Bot API token (Telegram Worker and webhook setup script; never expose client-side)
TELEGRAM_BOT_TOKEN=123456:replace-me
# Public deployed endpoint used only by scripts/telegram-webhook.ts set
TELEGRAM_WEBHOOK_URL=https://your-telegram-worker.example.com/api/telegram
# Random Telegram webhook header secret (app + setup script)
TELEGRAM_WEBHOOK_SECRET=replace-with-64-hex-characters
# Separate HMAC secret, at least 32 bytes, used only by the authenticated app webhook boundary
TELEGRAM_ID_HASH_SECRET=replace-with-a-different-64-hex-character-secret
# Optional for webhook delete; false preserves pending Telegram updates
TELEGRAM_DROP_PENDING_UPDATES=false

# Voyage AI (hosted reranker for search_events stage-2; optional - search falls back to retrieval order without it)
VOYAGE_API_KEY=
# VOYAGE_RERANK_MODEL=rerank-2.5-lite

# Feedback alerts (Resend). The sender address must be verified in Resend.
RESEND_API_KEY=re_your-key
FEEDBACK_ALERT_FROM=Your App <feedback@example.com>
FEEDBACK_ALERT_TO=maintainer@example.com

# Optional browser analytics (leave the key empty to disable)
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Browser acquisition (your own account/project; use a scoped Browser Run token)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_BROWSER_TOKEN=
BROWSERBASE_PROJECT_ID=

# Shared server-only web chat delivery secret; use the same value on both Workers
CHAT_DELIVERY_SECRET=
