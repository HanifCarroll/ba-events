# Supabase (server-side)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Supabase (browser-side - must be VITE_ prefixed for Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# OpenAI (for embeddings)
OPENAI_API_KEY=sk-your-openai-key

# Anthropic (for Claude agent)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Upstash Redis (for rate limiting - optional for local dev)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Admin API Key (for /api/events endpoint - optional for local dev)
ADMIN_API_KEY=your-secret-api-key
