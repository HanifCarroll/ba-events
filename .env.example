# Supabase (server-side)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase (browser-side - must be VITE_ prefixed for Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# OpenAI (for embeddings, text-embedding-3-small)
OPENAI_API_KEY=sk-your-openai-key

# DeepSeek (for text generation, deepseek-v4-flash, via the Vercel AI SDK)
DEEPSEEK_API_KEY=
AI_MODEL=deepseek-v4-flash
AI_BASE_URL=https://api.deepseek.com

# Admin API Key (for /api/events endpoint - optional for local dev)
ADMIN_API_KEY=your-secret-api-key

# Browserbase (cloud browser for Meetup scraping in prod)
BROWSERBASE_API_KEY=bb_live_your-key
