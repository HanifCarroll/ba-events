# Supabase (server-side)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase (browser-side - must be VITE_ prefixed for Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# OpenAI (for embeddings, text-embedding-3-small)
OPENAI_API_KEY=sk-your-openai-key

# DeepSeek (for text generation, deepseek-v4-pro, via the Vercel AI SDK)
DEEPSEEK_API_KEY=
AI_MODEL=deepseek-v4-pro
AI_BASE_URL=https://api.deepseek.com

# Admin API Key (for /api/events endpoint - optional for local dev)
ADMIN_API_KEY=your-secret-api-key

# Browserbase (cloud browser for Passline/Meetup scraping in prod - bypasses datacenter-IP blocks)
BROWSERBASE_API_KEY=bb_live_your-key

# Trigger.dev (background jobs; SDK reads TRIGGER_SECRET_KEY)
# Dev key (tr_dev_...) from the dashboard for local `trigger dev` runs.
# Prod key (tr_prod_...) from dashboard → env/prod → API keys; use with
# configure({ secretKey: process.env.TRIGGER_SECRET_KEY_PROD }) to view/trigger prod runs.
TRIGGER_SECRET_KEY=tr_dev_your-key
TRIGGER_SECRET_KEY_PROD=tr_prod_your-key

# Voyage AI (hosted reranker for search_events stage-2; optional - search falls back to retrieval order without it)
VOYAGE_API_KEY=
# VOYAGE_RERANK_MODEL=rerank-2.5-lite
