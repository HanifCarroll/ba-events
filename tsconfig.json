{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		"plugins": [
			{ "name": "typescript-svelte-plugin" },
			{
				"name": "@effect/language-service",
				"diagnostics": true,
				"diagnosticsName": true,
				"diagnosticSeverity": {
					"floatingEffect": "error",
					"outdatedApi": "error"
				}
			}
		]
	},
	"include": [
		".svelte-kit/types/**/$types.d.ts",
		"src/**/*.js",
		"src/**/*.ts",
		"src/**/*.svelte",
		"evals/**/*.ts",
		"scripts/**/*.ts",
		"vite.config.ts"
	],
	"exclude": [
		"src/service-worker.ts",
		"scripts/**/*.mjs"
	]
}
