{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true
	},
	"include": [
		".svelte-kit/types/**/$types.d.ts",
		"src/**/*.js",
		"src/**/*.ts",
		"src/**/*.svelte",
		"evals/**/*.ts",
		"scripts/**/*.ts",
		"vite.config.ts"
	],
	"exclude": [
		"src/service-worker.ts",
		"scripts/**/*.mjs"
	]
}
