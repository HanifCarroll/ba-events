{
	"name": "ba-events",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 3001",
		"build": "vite build",
		"deploy": "bun run build && wrangler deploy --config wrangler.jsonc && wrangler deploy --config wrangler.chat.jsonc",
		"cloudflare:ci": "bun run paraglide:compile && bun test && bun run test && bun run check && bunx tsc --noEmit && git diff --check",
		"cloudflare:build": "bun install --frozen-lockfile && bun run cloudflare:ci && bun run build",
		"cloudflare:deploy": "env -u WRANGLER_CI_MATCH_TAG -u WRANGLER_CI_OVERRIDE_NAME wrangler deploy --config wrangler.telegram.jsonc && env -u WRANGLER_CI_MATCH_TAG -u WRANGLER_CI_OVERRIDE_NAME wrangler deploy --config wrangler.mcp.jsonc && wrangler deploy --config wrangler.jsonc && env -u WRANGLER_CI_MATCH_TAG -u WRANGLER_CI_OVERRIDE_NAME wrangler deploy --config wrangler.chat.jsonc",
		"preview": "vite preview",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && bun run effect:diagnostics",
		"effect:diagnostics": "effect-language-service diagnostics --project tsconfig.json --format text",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations --strategy cookie preferredLanguage baseLocale",
		"pretest": "bun run paraglide:compile",
		"test:unit": "vitest run",
		"test": "vitest run",
		"eval:concierge": "bun evals/concierge/run.ts",
		"eval:concierge:langfuse": "bun evals/concierge/langfuse.ts",
		"eval:concierge:multi": "bun evals/concierge/multi-turn.ts",
		"eval:concierge:thinking": "bun evals/concierge/compare-thinking.ts",
		"eval:concierge:injection": "bun evals/concierge/run-injection.ts",
		"eval:concierge:quality": "bun evals/concierge/run-quality.ts",
		"eval:concierge:judge-controls": "bun evals/concierge/run-quality-controls.ts",
		"eval:search": "bun evals/search/run.ts",
		"eval:search:semantic": "bun evals/search/run-semantic.ts",
		"eval:relevance": "bun evals/search/relevance/run.ts",
		"snapshot:search-corpus": "bun scripts/snapshot-search-corpus.ts",
		"source:health": "bun scripts/source-health.ts",
		"eval:titles": "bun evals/titles/run.ts",
		"eval:enrichment": "bun evals/enrichment/run.ts",
		"trigger:dev": "bunx trigger.dev@4.5.15 dev",
		"trigger:deploy": "bunx trigger.dev@4.5.15 deploy",
		"telegram:dry-run": "wrangler deploy --config wrangler.telegram.jsonc --dry-run",
		"telegram:deploy": "wrangler deploy --config wrangler.telegram.jsonc",
		"mcp:types": "wrangler types worker-configuration.d.ts --config wrangler.mcp.jsonc --include-runtime false --env-file /dev/null",
		"mcp:dry-run": "wrangler deploy --config wrangler.mcp.jsonc --dry-run",
		"mcp:deploy": "wrangler deploy --config wrangler.mcp.jsonc",
		"chat:dry-run": "wrangler deploy --config wrangler.chat.jsonc --dry-run",
		"chat:deploy": "wrangler deploy --config wrangler.chat.jsonc",
		"storybook": "bun run paraglide:compile && storybook dev -p 6006 --no-open",
		"build:storybook": "bun run paraglide:compile && storybook build",
		"test:storybook": "bun run paraglide:compile && vitest run --config vitest.storybook.config.ts",
		"chat:browser": "bun scripts/check-chat-lifecycle-browser.mjs",
		"chat:dogfood": "bun run build && bun scripts/check-chat-lifecycle-browser.mjs --live --production"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260901.1",
		"@effect/language-service": "0.87.2",
		"@inlang/paraglide-js": "^2.25.0",
		"@storybook/addon-a11y": "10.6.2",
		"@storybook/addon-docs": "10.6.2",
		"@storybook/addon-vitest": "10.6.2",
		"@storybook/sveltekit": "10.6.2",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^3.0.0-next.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@trigger.dev/build": "4.5.15",
		"@types/ws": "8.18.1",
		"@vitest/browser-playwright": "4.1.11",
		"bits-ui": "^2.19.0",
		"fake-indexeddb": "^6.2.5",
		"franc-min": "^6.2.0",
		"storybook": "10.6.2",
		"svelte": "^5.57.0",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"workerd": "1.20261013.1",
		"wrangler": "^4.127.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#shared/*": "./src/shared/*",
		"#features/*": "./src/features/*",
		"#trigger/*": "./src/trigger/*",
		"#paraglide/*": "./src/lib/paraglide/*"
	},
	"dependencies": {
		"@ai-sdk/deepseek": "^3.0.37",
		"@ai-sdk/openai": "^4.0.53",
		"@ai-sdk/svelte": "^5.0.87",
		"@browserbasehq/sdk": "^2.19.0",
		"@langfuse/client": "^5.13.1",
		"@langfuse/otel": "^5.13.1",
		"@langfuse/tracing": "^5.13.1",
		"@langfuse/vercel-ai-sdk": "^5.13.1",
		"@modelcontextprotocol/server": "2.0.0",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/context-async-hooks": "^2.12.0",
		"@opentelemetry/sdk-trace-base": "^2.12.0",
		"@supabase/ssr": "0.12.5",
		"@supabase/supabase-js": "^2.112.4",
		"@tailwindcss/vite": "^4.3.3",
		"@trigger.dev/sdk": "4.5.15",
		"agents": "0.22.0",
		"ai": "^7.0.87",
		"cheerio": "^1.2.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"date-fns-tz": "^3.2.0",
		"dexie": "^4.4.5",
		"dompurify": "^3.4.14",
		"effect": "4.0.0-rc.112",
		"gsap": "^3.15.0",
		"lucide-svelte": "^1.0.1",
		"marked": "^18.0.11",
		"playwright": "1.57.0",
		"posthog-js": "^1.424.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"ws": "^8.21.3",
		"zod": "^4.5.4"
	}
}
