{
	"name": "ba-events",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 3001",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations --strategy cookie preferredLanguage baseLocale",
		"pretest": "bun run paraglide:compile",
		"test:unit": "vitest run",
		"test": "vitest run",
		"eval:concierge": "bun evals/concierge/run.ts",
		"eval:topic-guard": "bun evals/topic-guard/run.ts",
		"eval:search": "bun evals/search/run.ts",
		"eval:search:semantic": "bun evals/search/run-semantic.ts",
		"eval:relevance": "bun evals/search/relevance/run.ts",
		"snapshot:search-corpus": "bun scripts/snapshot-search-corpus.ts",
		"eval:titles": "bun evals/titles/run.ts",
		"trigger:dev": "bunx trigger.dev@4.5.11 dev",
		"trigger:deploy": "bunx trigger.dev@4.5.11 deploy"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.24.1",
		"@trigger.dev/build": "4.5.11",
		"@sveltejs/adapter-netlify": "^7.0.0-next.8",
		"@sveltejs/kit": "^3.0.0-next.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/ws": "8.18.1",
		"bits-ui": "^2.16.3",
		"fake-indexeddb": "^6.2.5",
		"svelte": "^5.56.7",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.1.5",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#shared/*": "./src/shared/*",
		"#features/*": "./src/features/*",
		"#trigger/*": "./src/trigger/*",
		"#paraglide/*": "./src/lib/paraglide/*"
	},
	"dependencies": {
		"@ai-sdk/deepseek": "^3.0.28",
		"@ai-sdk/openai": "^4.0.42",
		"@ai-sdk/svelte": "^5.0.66",
		"@browserbasehq/sdk": "^2.18.0",
		"@supabase/ssr": "0.12.4",
		"@supabase/supabase-js": "^2.112.3",
		"@tailwindcss/vite": "^4.3.3",
		"@trigger.dev/sdk": "4.5.11",
		"ai": "^7.0.66",
		"cheerio": "^1.2.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"date-fns-tz": "^3.2.0",
		"dexie": "^4.4.5",
		"dompurify": "^3.4.13",
		"gsap": "^3.15.0",
		"lucide-svelte": "^1.0.1",
		"marked": "^18.0.9",
		"playwright": "1.57.0",
		"posthog-js": "^1.417.1",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"ws": "^8.21.3",
		"zod": "^4.4.3"
	}
}
