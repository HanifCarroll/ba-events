{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baeventos-mcp",
  "main": "src/mcp-worker/index.ts",
  "account_id": "38d9d25d890a220fb7cf6dd92f8a322a",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  // D1 cutover (docs/ops/d1-cutover.md): search and get_event read D1 and Vectorize.
  "d1_databases": [{ "binding": "DB", "database_name": "baeventos-production", "database_id": "REPLACE_WITH_BAEVENTOS_PRODUCTION_D1_ID", "migrations_dir": "migrations" }],
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "baeventos-events" }],
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMIT",
      "namespace_id": "26082602",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
