{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baeventos",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "account_id": "38d9d25d890a220fb7cf6dd92f8a322a",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
    "enable_request_signal"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "workers_dev": true,
  "images": { "binding": "IMAGES" },
  // Cloudflare Email Sending for feedback alerts (src/shared/lib/feedback/alert.server.ts).
  // Feedback alerts (alerts@) and Better Auth magic links (accounts@, src/features/auth/api/magic-link-email.server.ts).
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["alerts@baeventos.com", "accounts@baeventos.com"] }],
  // D1 cutover (docs/ops/d1-cutover.md): these bindings switch the Worker from Supabase to D1, Vectorize and R2.
  // Hermes replaces the database_id placeholder with the id of `baeventos-production`; CI refuses to deploy it as is.
  "d1_databases": [{ "binding": "DB", "database_name": "baeventos-production", "database_id": "REPLACE_WITH_BAEVENTOS_PRODUCTION_D1_ID", "migrations_dir": "migrations" }],
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "baeventos-events" }],
  "r2_buckets": [{ "binding": "ARTWORK", "bucket_name": "baeventos-artwork" }],
  "durable_objects": {
    "bindings": [{ "name": "CHAT_DELIVERY", "class_name": "ChatDelivery", "script_name": "baeventos-chat-delivery" }]
  },
  "preview_urls": false,
  "routes": [
    {
      "pattern": "baeventos.com/*",
      "zone_name": "baeventos.com"
    },
    {
      "pattern": "www.baeventos.com/*",
      "zone_name": "baeventos.com"
    },
    {
      "pattern": "salidasba.com/*",
      "zone_name": "salidasba.com"
    },
    {
      "pattern": "www.salidasba.com/*",
      "zone_name": "salidasba.com"
    },
    {
      "pattern": "baeventos.app/*",
      "zone_name": "baeventos.app"
    },
    {
      "pattern": "www.baeventos.app/*",
      "zone_name": "baeventos.app"
    }
  ]
}
