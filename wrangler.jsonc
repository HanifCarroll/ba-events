{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baeventos",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "account_id": "38d9d25d890a220fb7cf6dd92f8a322a",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  },
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "baeventos.com/*",
      "zone_name": "baeventos.com"
    },
    {
      "pattern": "www.baeventos.com/*",
      "zone_name": "baeventos.com"
    }
  ]
}
