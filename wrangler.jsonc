{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baeventos",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "account_id": "38d9d25d890a220fb7cf6dd92f8a322a",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
    "enable_request_signal"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "workers_dev": true,
  "images": { "binding": "IMAGES" },
  "durable_objects": {
    "bindings": [{ "name": "CHAT_DELIVERY", "class_name": "ChatDelivery", "script_name": "baeventos-chat-delivery" }]
  },
  "preview_urls": false,
  "routes": [
    {
      "pattern": "baeventos.com/*",
      "zone_name": "baeventos.com"
    },
    {
      "pattern": "www.baeventos.com/*",
      "zone_name": "baeventos.com"
    }
  ]
}
